{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "description": "Renovate configuration for postgres-backup-s3cmd",
  "packageRules": [
    {
      "description": "Disable Alpine auto-updates (manually controlled per PG version)",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "alpine"
      ],
      "enabled": false
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    }
  ],
  "customManagers": [
    {
      "description": "Track go-cron version in install.sh",
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/install\\.sh$/"
      ],
      "matchStrings": [
        "GO_CRON_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "ivoronin/go-cron",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Track Alpine versions in GitHub Actions build matrix (per PG major)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/build-and-push\\.yml$/"
      ],
      "matchStrings": [
        "-\\s*pg:\\s*(?<pg>\\d+)\\s*\\n\\s*alpine:\\s*['\\\"](?<currentValue>[^'\\\"]+)['\\\"]"
      ],
      "depNameTemplate": "alpine-pg{{{pg}}}",
      "packageNameTemplate": "alpine",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ]
}
