{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "description": "Renovate configuration for postgres-backup-s3cmd",
  "packageRules": [
    {
      "description": "Disable Alpine auto-updates (manually controlled per PG version)",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["alpine"],
      "enabled": false
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    }
  ],
  "customManagers": [
    {
      "description": "Track go-cron version in install.sh",
      "customType": "regex",
      "fileMatch": ["^src/install\\.sh$"],
      "matchStrings": [
        "GO_CRON_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "ivoronin/go-cron",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
