# PostgreSQL Connection
# ---------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
# Omit POSTGRES_DATABASE to backup all databases (pg_dumpall)
POSTGRES_DATABASE=mydb
# Additional pg_dump/pg_dumpall options
PGDUMP_EXTRA_OPTS=

# S3 Configuration
# ----------------
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=my-backup-bucket
# Region (for AWS S3, ignored for custom endpoints)
S3_REGION=us-east-1
# Prefix/folder for backups
S3_PREFIX=backup
# Custom endpoint for S3-compatible storage (MinIO, Ceph, Wasabi, etc.)
# Examples:
#   MinIO: http://minio:9000
#   Wasabi: https://s3.wasabisys.com
#   Ceph RGW: https://rgw.example.com
S3_ENDPOINT=
# Bucket URL style: 'virtual' (default) or 'path'
# - virtual: https://bucket.endpoint (default, works with most S3-compatible)
# - path: https://endpoint/bucket (some S3-compatible need this)
# Omit for automatic selection (virtual-hosted style)
S3_BUCKET_STYLE=

# Advanced: s3cmd config file handling
# - By default, the container generates an s3cmd config at /root/.s3cfg from env vars.
# - If you mount your own config (e.g., as a Docker/K8s secret), you can set:
#     S3CFG_USE_EXISTING=true
#     S3CFG_PATH=/run/secrets/s3cfg
#   and omit S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY.
S3CFG_PATH=
S3CFG_USE_EXISTING=

# Backup Configuration
# --------------------
# Cron schedule for automatic backups
# Examples: @daily, @hourly, @weekly, '0 2 * * *' (2 AM daily)
# Omit for single backup on container start
SCHEDULE=@daily
# GPG passphrase for encryption (optional)
PASSPHRASE=
# Auto-delete backups older than N days (optional)
BACKUP_KEEP_DAYS=7
